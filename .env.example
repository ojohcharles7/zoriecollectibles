# Zorie Collectibles — environment variables
# Copy this file to `.env` and fill in the values, or set the same
# variables in your Vercel project dashboard (Settings → Environment Variables).
#
# IMPORTANT:
#   SUPABASE_URL and SUPABASE_ANON_KEY are public-by-design (the browser needs
#   them; row-level security protects your data).
#   SUPABASE_DB_PASSWORD is a REAL SECRET — server-side only, never exposed
#   to the browser, never placed in config.js.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=

# Supabase Auth user created for the admin dashboard (required for admin sign-in)
ADMIN_EMAIL=

# Paystack public key (pk_test_… while testing, pk_live_… when live)
PAYSTACK_PUBLIC_KEY=